rules_version = '2';

// MatchPulse Cloud Storage rules — main site owns the (default) bucket.
// Profile pictures are the only content stored here today; sport apps do
// not write. Reads are public because the URL is embedded on every page a
// user appears on. Writes are limited to the picture's owner, cap 5 MB,
// image mime-types only.
service firebase.storage {
  match /b/{bucket}/o {

    // /profilePictures/{uid}.{ext} — one picture per user, they own the write.
    match /profilePictures/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && filename.matches('^' + request.auth.uid + '\\..+')
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Org logos (≤2 MB) and banners (≤5 MB), keyed by orgId. Public read (the
    // URL is embedded on public org pages across every sport). Storage rules
    // can't read Firestore to check org ownership, so writes are gated only on
    // sign-in + size + image type — mirroring the sport apps' asset pattern.
    // The authored URL lands on the org doc, which the Firestore rules DO
    // protect to owner/admin, so a stray upload can't attach itself to an org.
    match /org-logos/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.resource == null
            || (request.resource.size < 2 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
    match /org-banners/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // Everything else denied by default.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
