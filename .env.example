# Firebase Web Config
# Firebase Console → Project Settings → Your apps → Web app.
# In CI these are GitHub Actions secrets with the same names:
# Settings → Secrets and variables → Actions → New repository secret.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=match-pulse-4560e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=match-pulse-4560e
VITE_FIREBASE_STORAGE_BUCKET=match-pulse-4560e.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Cloud Functions region. NOT the Firestore region (that is africa-south1).
# Only set this if `firebase functions:list` shows something other than the default.
# VITE_FUNCTIONS_REGION=europe-west1
