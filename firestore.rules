rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity database (default) ───────────────────────────────────────────
    // Holds the SHARED identity used across every MatchPulse sport and the main
    // site: users (auth/roles), userProfiles (public-safe subset) and people
    // (player profiles). Sport content (matches, competitions, teams, players,
    // organisations, …) lives in per-sport databases (e.g. `hockey`) with their
    // own rulesets. Rules cannot read across databases, so platform-admin
    // authority here also honours the `platformAdmin` custom claim the per-sport
    // databases rely on.

    function isSignedIn() {
      return request.auth != null;
    }

    // Prefers the platformAdmin custom claim (the authority the per-sport
    // databases use); falls back to the users doc, which lives in THIS database.
    function isPlatformAdmin() {
      return isSignedIn()
        && (request.auth.token.get('platformAdmin', false) == true
            || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('platformAdmin', false) == true));
    }

    // ── People (player profiles) ──────────────────────────────────────────────
    // Controlled by its owner (people.ownerUid) or a parent/guardian
    // (uid in people.guardianUids). Delegated managers (uid in people.managerUids)
    // may edit the profile but never the control fields. Career-stat fields are
    // written by the stats engine via the Admin SDK (which bypasses these rules),
    // so there is NO client career-stat write path here.

    function controlsPerson(p) {
      return isSignedIn() && (
        p.get('ownerUid', '') == request.auth.uid
        || request.auth.uid in p.get('guardianUids', [])
      );
    }

    function managesPerson(p) {
      return isSignedIn() && request.auth.uid in p.get('managerUids', []);
    }

    function personControlFieldsUnchanged() {
      return request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('guardianUids', []) == resource.data.get('guardianUids', [])
        && request.resource.data.get('managerUids', []) == resource.data.get('managerUids', []);
    }

    // The consent record stamped at creation is immutable (only a platform admin
    // may bypass this).
    function consentFieldsUnchanged() {
      return request.resource.data.get('consentGiven', false) == resource.data.get('consentGiven', false)
        && request.resource.data.get('consentTextVersion', '') == resource.data.get('consentTextVersion', '')
        && request.resource.data.get('consentTimestamp', null) == resource.data.get('consentTimestamp', null)
        && request.resource.data.get('consentByUid', '') == resource.data.get('consentByUid', '');
    }

    match /people/{id} {
      allow read: if true;

      // Create: platform admin; or a user creating a profile they will control —
      // a player (self as ownerUid), a parent (self in guardianUids) or a manager
      // (self in managerUids) — with an immutable consent record (given, versioned,
      // by self). Orgs/coaches cannot mint an uncontrolled profile.
      allow create: if isPlatformAdmin()
        || (isSignedIn()
            && request.resource.data.get('consentGiven', false) == true
            && request.resource.data.get('consentByUid', '') == request.auth.uid
            && request.resource.data.get('consentTextVersion', '') != ''
            && (
              (request.resource.data.keys().hasAny(['ownerUid'])
                && request.resource.data.ownerUid == request.auth.uid)
              || (request.resource.data.keys().hasAny(['guardianUids'])
                && request.auth.uid in request.resource.data.guardianUids)
              || (request.resource.data.keys().hasAny(['managerUids'])
                && request.auth.uid in request.resource.data.managerUids)));

      // Update: platform admin; owner/guardian (full control, incl. transfer +
      // manager grants); a delegated manager (everything EXCEPT the control
      // fields); or a self-service CLAIM of an unclaimed profile (no owner, no
      // guardians) making self the owner (player) or sole guardian (parent).
      allow update: if isPlatformAdmin()
        || (controlsPerson(resource.data) && consentFieldsUnchanged())
        || (managesPerson(resource.data) && personControlFieldsUnchanged() && consentFieldsUnchanged())
        || (isSignedIn()
            // Team-sheet-created profiles are claimable ONLY through the
            // verified-email branch — never this legacy unverified path.
            && resource.data.get('createdVia', '') != 'teamSheet'
            && resource.data.get('ownerUid', null) == null
            && resource.data.get('guardianUids', []).size() == 0
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['ownerUid', 'guardianUids', 'updatedAt', 'updatedBy'])
            && (
                 (request.resource.data.get('ownerUid', null) == request.auth.uid
                   && request.resource.data.get('guardianUids', []).size() == 0)
                 || (request.resource.data.get('ownerUid', null) == null
                   && request.resource.data.get('guardianUids', []) == [request.auth.uid])
               ));

      allow delete: if isPlatformAdmin() || controlsPerson(resource.data);
    }

    // ── User profiles (public-safe subset) ────────────────────────────────────
    match /userProfiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if (isSignedIn() && request.auth.uid == uid) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Full profile with privileged fields (platformAdmin, permissionOverrides,
    // orgRoles, competitionRoles, entitlement). Self-writes cannot touch
    // platformAdmin/permissionOverrides or self-grant entitlement; those are
    // platform-admin / Admin-SDK (PayFast ITN) only.
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isPlatformAdmin();

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('platformAdmin', false) == false
        && request.resource.data.get('permissionOverrides', {}) == {}
        && request.resource.data.get('entitlement', 'none') == 'none'
        && request.resource.data.get('eventCredits', 0) == 0
        && request.resource.data.get('entitlementExpiresAt', null) == null;

      // Self-update: cannot change admin/override flags or self-grant entitlement.
      // eventCredits may only DECREASE (consuming a credit) — never increase.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('platformAdmin', false) == resource.data.get('platformAdmin', false)
        && request.resource.data.get('permissionOverrides', {}) == resource.data.get('permissionOverrides', {})
        && request.resource.data.get('entitlement', 'none') == resource.data.get('entitlement', 'none')
        && request.resource.data.get('entitlementExpiresAt', null) == resource.data.get('entitlementExpiresAt', null)
        && request.resource.data.get('eventCredits', 0) <= resource.data.get('eventCredits', 0);

      // orgRoles is now maintained ONLY by the syncOrgRoleClaim function (Admin
      // SDK, derived from the authoritative staff subcollection). The old
      // client cache-write path is removed — it let any signed-in user rewrite
      // any user's orgRoles, and it is now both redundant and a drift risk.
      //
      // competitionRoles has no server mirror yet, so its scoped cache-write
      // stays until one exists. It is a non-authoritative cache — sport rules
      // never treat it as authority.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['competitionRoles']);

      // Master Admins may write any user document.
      allow write: if isPlatformAdmin();
    }

    // ── Organisations ─────────────────────────────────────────────────────────
    // MatchPulse-level, NOT sport-specific: one org runs competitions across any
    // number of sports, so the record and its plan live here in (default) and
    // every sport database references it by ID.
    //
    // Billing fields (entitlement, eventCredits, entitlementExpiresAt) are
    // written ONLY by the Admin SDK — the PayFast ITN and credit consumption.
    // No client path may set or change them, which is what keeps a compromised
    // or buggy sport client from granting itself a plan.

    // Billing + the org-level profile subscription are server-written only (the
    // payment flow / admin grant via the Admin SDK). No client update may touch
    // them — public read is fine; the paid gate is enforced in the aggregation
    // function, not by hiding the field.
    function orgBillingUnchanged() {
      return request.resource.data.get('entitlement', 'none') == resource.data.get('entitlement', 'none')
        && request.resource.data.get('eventCredits', 0) == resource.data.get('eventCredits', 0)
        && request.resource.data.get('entitlementExpiresAt', null) == resource.data.get('entitlementExpiresAt', null)
        && request.resource.data.get('profileSubscription', null) == resource.data.get('profileSubscription', null);
    }

    // Owner of an org is the reassignable ownerUserId FIELD on the org doc —
    // the single authority for editing identity, transferring ownership and
    // managing the staff roster. (The previous staff-subcollection-derived
    // owner check is retired.)
    function orgOwnerUid(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUserId', '');
    }

    // On update, createdBy and createdAt (the creation record) are always fixed.
    // slug is fixed for owners but a PLATFORM ADMIN may change it (Brief #4) —
    // the transactional re-reservation of orgSlugs happens client-side.
    function orgImmutableUnchanged() {
      return (request.resource.data.get('slug', '') == resource.data.get('slug', '') || isPlatformAdmin())
        && request.resource.data.get('createdBy', '')   == resource.data.get('createdBy', '')
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // ownerUserId may change ONLY when the caller is a platform admin or the
    // CURRENT owner (the transfer). Unchanged ownerUserId is always fine.
    function orgOwnerChangeAuthorised() {
      return request.resource.data.get('ownerUserId', '') == resource.data.get('ownerUserId', '')
        || isPlatformAdmin()
        || request.auth.uid == resource.data.get('ownerUserId', '');
    }

    match /organizations/{orgId} {
      // Org pages are public across every sport site.
      allow read: if true;

      // Create: signed-in, sets self as owner, and grants itself no billing.
      // (Billing fields default absent → 'none'/0/null, which the rule requires.)
      allow create: if isSignedIn()
        && request.resource.data.get('ownerUserId', '') == request.auth.uid
        && request.resource.data.get('entitlement', 'none') == 'none'
        && request.resource.data.get('eventCredits', 0) == 0
        && request.resource.data.get('entitlementExpiresAt', null) == null;

      // Update: platform admin or the current owner. Billing untouchable,
      // slug/createdBy/createdAt immutable, owner change only via the transfer.
      allow update: if (isPlatformAdmin()
              || request.auth.uid == resource.data.get('ownerUserId', ''))
        && orgBillingUnchanged()
        && orgImmutableUnchanged()
        && orgOwnerChangeAuthorised();

      allow delete: if isPlatformAdmin()
        || request.auth.uid == resource.data.get('ownerUserId', '');

      // Staff roster (owner/staff/scorer, optionally team-scoped) — written by
      // the org owner or a platform admin. syncOrgRoleClaim mirrors changes here
      // onto users/{uid}.orgRoles.
      match /staff/{uid} {
        allow read:  if isSignedIn();
        allow write: if isPlatformAdmin() || request.auth.uid == orgOwnerUid(orgId);
      }
    }

    // ── Org slug registry ─────────────────────────────────────────────────────
    // One platform-wide namespace: orgSlugs/{slug} reserves a slug at org create
    // (written transactionally with the org doc). Public read so the create form
    // can dedupe and so a slug can be resolved to an orgId. Create-only for
    // signed-in users stamping themselves as createdBy; never updated (slugs are
    // immutable); deletable only by an admin (cleanup / re-seeding).
    match /orgSlugs/{slug} {
      allow read:   if true;
      allow create: if isSignedIn()
        && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if false;
      // Deletable by a platform admin (re-seeding / admin slug edit) or by the
      // CURRENT owner of the org this slug points at — so deleting an org can
      // release its slug for reuse. The org doc is read from pre-transaction
      // state, so this still resolves during the org's own delete transaction.
      allow delete: if isPlatformAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/organizations/$(resource.data.orgId))
            && request.auth.uid == get(/databases/$(database)/documents/organizations/$(resource.data.orgId)).data.get('ownerUserId', ''));
    }



    // ── Invoices (EFT billing) ────────────────────────────────────────────────
    // Created and paid/voided ONLY via callables (Admin SDK) — numbering,
    // pricing and the grant-on-payment all happen server-side. The one client
    // write allowed: the invoice's owner may correct WHO IT IS BILLED TO while
    // it is still outstanding (the accounts-department-says-it's-wrong case).
    // Status, amount, plan and number are untouchable from the client.
    match /invoices/{id} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'outstanding'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['billTo', 'updatedAt']);

      allow create, delete: if false;
    }

    // Outbound email queue — written by functions, drained by the (future)
    // email sender. No client access.
    match /mailQueue/{id} {
      allow read, write: if false;
    }

    // ── Contact messages ─────────────────────────────────────────────────────
    // Written only by submitContactForm (Admin SDK, bypasses rules); readable
    // and mutable (mark-as-read) by platform admins. No client create path —
    // that would let anyone spam the collection past the function's rate limit.
    match /contactMessages/{id} {
      allow read:   if isPlatformAdmin();
      allow update: if isPlatformAdmin();
      allow create, delete: if false;
    }

    // ── Payments (PayFast ITN audit trail) ────────────────────────────────────
    // Every ITN is recorded here for reconciliation, including ones that could
    // not be attributed to an account. Written only by the webhook via the Admin
    // SDK; readable only by a platform admin, since it holds payer details.
    match /payments/{id} {
      allow read:  if isPlatformAdmin();
      allow write: if false;
    }

    // ── Platform config ───────────────────────────────────────────────────────
    // _meta/seoSettings is the site's editable SEO defaults (title, description,
    // og:image, …). Read publicly (every page loads it to populate document.head);
    // written only by a platform admin from the admin panel.
    match /_meta/seoSettings {
      allow read:  if true;
      allow write: if isPlatformAdmin();
    }

    // Everything else under _meta (e.g. payfastConfig, which holds the PayFast
    // passphrase) stays closed to clients — the webhook reads it via the Admin
    // SDK, which bypasses rules.
    match /_meta/{doc} {
      allow read, write: if false;
    }

    // ── Venue registry (Brief A) ──────────────────────────────────────────────
    // Central venues, read by the public site and every sport app (via the
    // (default) handle). Public read on ACTIVE venues only. NO client writes at
    // all — createVenue / updateVenue / mergeVenues (Admin SDK callables) are the
    // only write path, and the sport apps read but never write.
    match /venues/{venueId} {
      allow read:  if resource.data.active == true;
      allow write: if false;
    }

    // The lightweight typeahead index (venueIndex/current), rebuilt by a trigger
    // on every venue write. Public read; written only by the Admin SDK trigger.
    match /venueIndex/{doc} {
      allow read:  if true;
      allow write: if false;
    }

  }
}
